---
import { Image } from "astro:assets";

import "./styles.css";
import { Icon } from "astro-icon/components";

export interface Props {
	companyName: string;
	companyLogo: string;
	companyWebsite: string;
	positions: {
		jobTitle: string;
		duration: string;
		points?: string[];
		techStack?: string[];
	}[];
}

const { companyName, companyLogo, companyWebsite, positions } = Astro.props;
---

<div class="experience-card">
	<Image
		src={companyLogo}
		alt={companyName}
		class="company-logo"
		width={48}
		height={48}
	/>

	<div class="company-description">
		<h3 class="company-name">
			{companyName} 
			<span>
				<a
					href={companyWebsite}
					target="_blank"
				>
					<Icon
						name="ri:arrow-right-up-line"
						title={companyWebsite}
						class="external-link"
					/></a
				>
			</span>
		</h3>

		<div class="positions-container">
			{positions.map((position, index) => (
				<div class="position-container">
					{positions.length > 1 && 
						<div class="timeline-container">
							<div class="timeline-dot"></div>
							{index < positions.length - 1 && <div class="timeline-line"></div>}
						</div>
					}

					<div class="position">
						<h4>{position.jobTitle}</h4>
						<p>{position.duration}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</div>
